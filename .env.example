# PostgreSQL connection for Retail Intelligence (Tasks 5.1, 5.2.1).
# Copy this file to .env and fill in the passwords. .env is excluded from Git; never commit it.
# Variables already set in the process environment take precedence over .env.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Project database (created by: python -m src.database create-db)
POSTGRES_DB=retail_intelligence
# Seconds to wait for a connection before failing
POSTGRES_CONNECT_TIMEOUT=10

# Application role used by the project code (created by: python -m src.database setup-app-role)
POSTGRES_USER=retail_app
POSTGRES_PASSWORD=

# Administrative login: only for creating the database and the application role
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=
# Existing database used for administration
POSTGRES_ADMIN_DB=postgres

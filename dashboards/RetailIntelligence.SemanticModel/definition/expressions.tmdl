/// PostgreSQL server (host:port) of the Retail Intelligence warehouse. Credentials are never stored here:
/// Power BI Desktop asks for them once and keeps them in its local credential store.
expression ServerName = "localhost:5432" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	lineageTag: 159b3b6e-344d-4e89-9e54-24ea8d722df2

	annotation PBI_ResultType = Text

